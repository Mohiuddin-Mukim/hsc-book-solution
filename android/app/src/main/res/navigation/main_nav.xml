<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main_nav" app:startDestination="@id/loginFragment">

    <fragment android:id="@+id/loginFragment"
        android:name="bd.hscsolution.student.ui.LoginFragment" android:label="Login">
        <action android:id="@+id/action_login_to_home" app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment" app:popUpToInclusive="true"/>
        <action android:id="@+id/action_login_to_register" app:destination="@id/registerFragment"/>
    </fragment>

    <fragment android:id="@+id/registerFragment"
        android:name="bd.hscsolution.student.ui.RegisterFragment" android:label="Create account">
        <action android:id="@+id/action_register_to_login" app:destination="@id/loginFragment"
            app:popUpTo="@id/registerFragment" app:popUpToInclusive="true"/>
    </fragment>

    <fragment android:id="@+id/homeFragment"
        android:name="bd.hscsolution.student.ui.HomeFragment" android:label="Home">
        <action android:id="@+id/action_home_to_login" app:destination="@id/loginFragment"
            app:popUpTo="@id/homeFragment" app:popUpToInclusive="true"/>
        <action android:id="@+id/action_home_to_papers" app:destination="@id/paperFragment"/>
        <action android:id="@+id/action_home_to_search" app:destination="@id/searchFragment"/>
    </fragment>

    <fragment android:id="@+id/paperFragment"
        android:name="bd.hscsolution.student.ui.PaperFragment" android:label="Papers">
        <argument android:name="subjectId" app:argType="string"/>
        <argument android:name="subjectName" app:argType="string"/>
        <action android:id="@+id/action_paper_to_chapters" app:destination="@id/chapterFragment"/>
        <action android:id="@+id/action_paper_to_books" app:destination="@id/bookFragment"/>
    </fragment>

    <fragment android:id="@+id/bookFragment"
        android:name="bd.hscsolution.student.ui.BookFragment" android:label="Books">
        <argument android:name="subjectId" app:argType="string"/>
        <argument android:name="subjectName" app:argType="string"/>
        <action android:id="@+id/action_book_to_editions" app:destination="@id/editionFragment"/>
    </fragment>

    <fragment android:id="@+id/editionFragment"
        android:name="bd.hscsolution.student.ui.EditionFragment" android:label="Editions">
        <argument android:name="bookId" app:argType="string"/>
        <argument android:name="bookTitle" app:argType="string"/>
    </fragment>

    <fragment android:id="@+id/chapterFragment"
        android:name="bd.hscsolution.student.ui.ChapterFragment" android:label="Chapters">
        <argument android:name="paperId" app:argType="string"/>
        <argument android:name="paperName" app:argType="string"/>
        <action android:id="@+id/action_chapter_to_questions" app:destination="@id/questionListFragment"/>
    </fragment>

    <fragment android:id="@+id/questionListFragment"
        android:name="bd.hscsolution.student.ui.QuestionListFragment" android:label="Questions">
        <argument android:name="chapterId" app:argType="string"/>
        <argument android:name="chapterName" app:argType="string"/>
        <action android:id="@+id/action_question_list_to_detail" app:destination="@id/questionDetailFragment"/>
    </fragment>

    <fragment android:id="@+id/searchFragment"
        android:name="bd.hscsolution.student.ui.SearchFragment" android:label="Search">
        <action android:id="@+id/action_search_to_detail" app:destination="@id/questionDetailFragment"/>
    </fragment>

    <fragment android:id="@+id/questionDetailFragment"
        android:name="bd.hscsolution.student.ui.QuestionDetailFragment" android:label="Solution">
        <argument android:name="questionId" app:argType="string"/>
        <argument android:name="language" app:argType="string" android:defaultValue="bn"/>
    </fragment>
</navigation>
