<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/surface">

    <!-- Top Dashboard Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp">

        <!-- Utility Row: Network Status + Logout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <TextView
                android:id="@+id/networkState"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.03"
                android:textColor="@color/secondary"
                android:ellipsize="end"
                android:maxLines="1"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/logoutButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:minWidth="0dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:text="@string/logout_button"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/text_secondary"
                app:cornerRadius="8dp"/>

        </LinearLayout>

        <!-- Greeting / Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_title"
            android:textSize="26sp"
            android:textStyle="bold"
            android:letterSpacing="-0.01"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_primary"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/home_subtitle"
            android:textSize="14sp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/text_secondary"/>

        <!-- Search Bar Action -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/searchButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="16dp"
            android:gravity="start|center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:text="Search questions"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textColor="@color/text_secondary"
            app:cornerRadius="14dp"
            app:strokeWidth="1dp"/>

        <!-- Quick Actions Row (Plans & Offline side-by-side) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/plansButton"
                style="@style/Widget.MaterialComponents.Button.UnelevatedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Plans and offers"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                app:cornerRadius="12dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/offlineButton"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:text="Offline downloads"
                android:textAllCaps="false"
                android:textSize="13sp"
                android:textColor="@color/text_primary"
                android:maxLines="1"
                android:ellipsize="end"
                app:cornerRadius="12dp"
                app:strokeWidth="1dp"/>

        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/transactionHistoryButton"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="end"
            android:layout_marginTop="4dp"
            android:text="Transaction history"
            android:textAllCaps="false" />

    </LinearLayout>

    <!-- Subtle Section Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/text_secondary"
        android:alpha="0.12"/>

    <!-- Loading Indicator -->
    <ProgressBar
        android:id="@+id/catalogProgress"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="24dp"
        android:layout_marginBottom="12dp"
        android:visibility="gone"/>

    <!-- Error State -->
    <TextView
        android:id="@+id/catalogError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginTop="16dp"
        android:padding="14dp"
        android:gravity="center"
        android:textSize="14sp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/error"
        android:visibility="gone"/>

    <!-- Retry Action -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/retryButton"
        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
        android:layout_width="wrap_content"
        android:layout_height="44dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:text="@string/retry"
        android:textAllCaps="false"
        app:cornerRadius="10dp"
        android:visibility="gone"/>

    <!-- Empty State -->
    <TextView
        android:id="@+id/emptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="28dp"
        android:paddingEnd="28dp"
        android:paddingTop="36dp"
        android:paddingBottom="28dp"
        android:gravity="center"
        android:text="@string/empty_subjects"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/text_secondary"
        android:visibility="gone"/>

    <!-- Subject List -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/subjectList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="20dp"
        android:clipToPadding="false"
        android:overScrollMode="never"/>

</LinearLayout>